generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model job_status {
  status_id   Int       @id @default(autoincrement())
  status_name String    @unique @db.VarChar(20)
  created_by  Int?
  updated_by  Int?
  deleted_by  Int?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  jobs        jobs[]
}

model jobs {
  job_id       Int        @id @default(autoincrement())
  job_uuid     String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_name     String     @db.VarChar(255)
  description  String?    @db.VarChar(255)
  detail       String?
  user_id      Int
  status_id    Int
  start_date   DateTime?  @db.Timestamptz(6)
  due_date     DateTime?  @db.Timestamptz(6)
  notify_at    DateTime?  @db.Timestamptz(6)
  completed_at DateTime?  @db.Timestamptz(6)
  created_by   Int?
  updated_by   Int?
  deleted_by   Int?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?  @db.Timestamptz(6)
  job_status   job_status @relation(fields: [status_id], references: [status_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_jobs_status")
  users        users      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_jobs_user")
}

model line_accounts {
  line_account_id Int      @id @default(autoincrement())
  user_id         Int
  line_user_id    String   @unique @db.VarChar(255)
  display_name    String?  @db.VarChar(255)
  linked_at       DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_line_accounts_user")
}

model roles {
  role_id    Int       @id @default(autoincrement())
  role_name  String    @unique @db.VarChar(20)
  created_by Int?
  updated_by Int?
  deleted_by Int?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users[]
}

model sessions {
  session_id Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sessions_user")
}

model users {
  user_id       Int             @id @default(autoincrement())
  user_uuid     String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_name     String          @db.VarChar(255)
  email         String          @unique @db.VarChar(100)
  password      String          @db.VarChar(255)
  role_id       Int
  is_active     Boolean         @default(true)
  created_by    Int?
  updated_by    Int?
  deleted_by    Int?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?       @db.Timestamptz(6)
  jobs          jobs[]
  line_accounts line_accounts[]
  sessions      sessions[]
  roles         roles           @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
}
